<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SauceDemo Test Suite" verbose="1">

    <listeners>
        <listener class-name="com.epam.campus.selenium.utils.TestListener"/>
        <listener class-name="com.epam.campus.selenium.utils.RetryTransformer"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="com.epam.campus.selenium.tests.LoginTests"/>
        </classes>
    </test>

    <test name="Product Interaction Tests">
        <classes>
            <class name="com.epam.campus.selenium.tests.ProductInteractionTests"/>
        </classes>
    </test>

    <test name="Sort Functionality Tests">
        <classes>
            <class name="com.epam.campus.selenium.tests.SortTests"/>
        </classes>
    </test>

    <test name="Logout Tests">
        <classes>
            <class name="com.epam.campus.selenium.tests.LogoutTests"/>
        </classes>
    </test>

</suite>
