<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CalculatorTestSuite"
       verbose="2"
       parallel="tests"
       thread-count="3"
       preserve-order="true">

    <test name="Calculator Assertion Tests">
        <classes>
            <class name="com.epam.campus.testng.CalculatorAssertionTest">
                <methods>
                    <include name="hardAssertions"/>
                    <include name="softAssertions"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
