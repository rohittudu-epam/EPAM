<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="CalculatorDependencyTestSuite"
       verbose="2"
       parallel="false">

    <test name="Calculator Dependency Tests">
        <classes>
            <class name="com.epam.campus.testng.CalculatorDependencyTest">
                <methods>
                    <include name="testInitializeCalculator"/>
                    <include name="testAddition"/>
                    <include name="testSubtraction"/>
                    <include name="testMultiplication"/>
                    <include name="testDivision"/>
                </methods>
            </class>
        </classes>
    </test>

</suite>
